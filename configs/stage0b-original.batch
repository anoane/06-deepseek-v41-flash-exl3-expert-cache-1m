# Recipe stage 0, window 0b (PLAN.md section 4): T12 bring-up at 1M, pipeline x tier, stable anchors, quality floor.
# T12 = 0-11=cuda:0; 12-39=cuda:1 experts=cache; ram experts=all; disk experts=off (CMP layers 0-11 resident, PRO 12-39
# from the VRAM cache backed by a RAM tier of every non-pool expert; zero expert SSD reads after the load).
# R0 = T12 + EXL3_DSV41_PIPELINE=1 EXL3_DSV41_PIPELINE_CHUNK=4096; generator chunk 16384 when pipelined, 4096 plain.
# MEMMAX=119G (127.8 GB) for the tier family; minavail = expected RSS (~72 GiB) + 16 GiB.

# ---- T-fit: R0 at 1M: sizing, VRAM left, RSS, SSD reads after load (must be 0), plain vs pipelined, greedy equality ----
#@ est=12 timeout=1500 minavail=88
T-fit | BENCH_PYTHON=/root/rnd/release/all/aux/py_memwatch.sh MEMWATCH_PY=/root/rnd/release/recipe/bench/py_mem.sh PYTORCH_ALLOC_CONF=backend:cudaMallocAsync PYTORCH_CUDA_ALLOC_CONF=backend:cudaMallocAsync PYTHONDONTWRITEBYTECODE=1 MEMMAX=119G EXL3_PLACEMENT='0-11=cuda:0; 12-39=cuda:1 experts=cache; ram experts=all; disk experts=off' EXL3_DSV41_PIPELINE=1 EXL3_DSV41_PIPELINE_CHUNK=4096 | --modes speed --prompt-tokens 2048,32768 --gen-tokens 256 --repeats 4 --no-raw --chunk 4096 --gen-chunk 16384 --warmup-gen 512 --vary pipeline=0/1/1/0 --expect-native-sha 823174af46fb
# ---- T-pipe-128k: CMP headroom under the pipeline at 128K, tier x pipeline together ----
#@ est=12 timeout=1500 minavail=88
T-pipe-128k | BENCH_PYTHON=/root/rnd/release/all/aux/py_memwatch.sh MEMWATCH_PY=/root/rnd/release/recipe/bench/py_mem.sh PYTORCH_ALLOC_CONF=backend:cudaMallocAsync PYTORCH_CUDA_ALLOC_CONF=backend:cudaMallocAsync PYTHONDONTWRITEBYTECODE=1 MEMMAX=119G EXL3_PLACEMENT='0-11=cuda:0; 12-39=cuda:1 experts=cache; ram experts=all; disk experts=off' EXL3_DSV41_PIPELINE=1 EXL3_DSV41_PIPELINE_CHUNK=4096 | --modes speed --prompt-tokens 131072 --gen-tokens 16 --repeats 2 --no-raw --chunk 4096 --gen-chunk 16384 --warmup-gen 512 --vary pipeline=1/0 --expect-native-sha 823174af46fb
# ---- stable anchors on T12: must be bitwise 65,535 / 65,535 (layers 12-39 are PRO-computed in both layouts) ----
#@ est=7 timeout=900 minavail=88
T12-stable-dsidx | BENCH_PYTHON=/root/rnd/release/all/aux/py_memwatch.sh MEMWATCH_PY=/root/rnd/release/recipe/bench/py_mem.sh PYTORCH_ALLOC_CONF=backend:cudaMallocAsync PYTORCH_CUDA_ALLOC_CONF=backend:cudaMallocAsync PYTHONDONTWRITEBYTECODE=1 MEMMAX=119G EXL3_PLACEMENT='0-11=cuda:0; 12-39=cuda:1 experts=cache; ram experts=all; disk experts=off' OMP_NUM_THREADS=2 EXL3_DSV41_ENGRAM_PREFETCH=1 EXL3_STABLE_ARITHMETIC=1 EXL3_HGEMM_FIXED_ROWS=128 EXL3_MOE_FUSED_PREFILL=1 EXL3_DSV41_NUMERICS=deepseek:index | --modes quality --quality-tokens 65536 --quality-chunk 4096 --max-output-size 4096 --anchor /root/rnd/numerics/n64k2_deepseek-index.npz --expect-native-sha 823174af46fb
#@ est=7 timeout=900 minavail=88
T12-stable-precise | BENCH_PYTHON=/root/rnd/release/all/aux/py_memwatch.sh MEMWATCH_PY=/root/rnd/release/recipe/bench/py_mem.sh PYTORCH_ALLOC_CONF=backend:cudaMallocAsync PYTORCH_CUDA_ALLOC_CONF=backend:cudaMallocAsync PYTHONDONTWRITEBYTECODE=1 MEMMAX=119G EXL3_PLACEMENT='0-11=cuda:0; 12-39=cuda:1 experts=cache; ram experts=all; disk experts=off' OMP_NUM_THREADS=2 EXL3_DSV41_ENGRAM_PREFETCH=1 EXL3_STABLE_ARITHMETIC=1 EXL3_HGEMM_FIXED_ROWS=128 EXL3_MOE_FUSED_PREFILL=1 EXL3_DSV41_NUMERICS=precise | --modes quality --quality-tokens 65536 --quality-chunk 4096 --max-output-size 4096 --anchor /root/rnd/numerics/n64k_place_precise.npz --expect-native-sha 823174af46fb
# ---- RQ: R0's 64K quality at three chunkings (the floor F); anchors: serving, stable deepseek:index, W1-c (L0), W1-a (PRO-only tier) ----
#@ est=7 timeout=900 minavail=88
RQ-4096 | BENCH_PYTHON=/root/rnd/release/all/aux/py_memwatch.sh MEMWATCH_PY=/root/rnd/release/recipe/bench/py_mem.sh PYTORCH_ALLOC_CONF=backend:cudaMallocAsync PYTORCH_CUDA_ALLOC_CONF=backend:cudaMallocAsync PYTHONDONTWRITEBYTECODE=1 MEMMAX=119G EXL3_PLACEMENT='0-11=cuda:0; 12-39=cuda:1 experts=cache; ram experts=all; disk experts=off' | --modes quality --quality-tokens 65536 --quality-chunk 4096 --anchor /root/rnd/proof/n64k_serving_deepseek-index.npz --anchor /root/rnd/numerics/n64k2_deepseek-index.npz --anchor /root/rnd/release/all/val/w1/runs-a/20260926-144016-09-W1-c-quality_quality.npz --anchor /root/rnd/release/all/val/w1/runs-b/20260926-145856-01-W1-a-quality_quality.npz --expect-native-sha 823174af46fb
#@ est=7 timeout=900 minavail=88
RQ-2048 | BENCH_PYTHON=/root/rnd/release/all/aux/py_memwatch.sh MEMWATCH_PY=/root/rnd/release/recipe/bench/py_mem.sh PYTORCH_ALLOC_CONF=backend:cudaMallocAsync PYTORCH_CUDA_ALLOC_CONF=backend:cudaMallocAsync PYTHONDONTWRITEBYTECODE=1 MEMMAX=119G EXL3_PLACEMENT='0-11=cuda:0; 12-39=cuda:1 experts=cache; ram experts=all; disk experts=off' | --modes quality --quality-tokens 65536 --quality-chunk 2048 --anchor /root/rnd/proof/n64k_serving_deepseek-index.npz --anchor /root/rnd/numerics/n64k2_deepseek-index.npz --anchor /root/rnd/release/all/val/w1/runs-a/20260926-144016-09-W1-c-quality_quality.npz --anchor /root/rnd/release/all/val/w1/runs-b/20260926-145856-01-W1-a-quality_quality.npz --anchor-label RQ-4096 --expect-native-sha 823174af46fb
#@ est=7 timeout=900 minavail=88
RQ-2047 | BENCH_PYTHON=/root/rnd/release/all/aux/py_memwatch.sh MEMWATCH_PY=/root/rnd/release/recipe/bench/py_mem.sh PYTORCH_ALLOC_CONF=backend:cudaMallocAsync PYTORCH_CUDA_ALLOC_CONF=backend:cudaMallocAsync PYTHONDONTWRITEBYTECODE=1 MEMMAX=119G EXL3_PLACEMENT='0-11=cuda:0; 12-39=cuda:1 experts=cache; ram experts=all; disk experts=off' | --modes quality --quality-tokens 65536 --quality-chunk 2047 --anchor /root/rnd/proof/n64k_serving_deepseek-index.npz --anchor /root/rnd/numerics/n64k2_deepseek-index.npz --anchor /root/rnd/release/all/val/w1/runs-a/20260926-144016-09-W1-c-quality_quality.npz --anchor /root/rnd/release/all/val/w1/runs-b/20260926-145856-01-W1-a-quality_quality.npz --anchor-label RQ-4096 --expect-native-sha 823174af46fb
# ---- optional: the stable profile's speed cost on T12 ----
#@ est=8 timeout=900 minavail=88 optional=1
T12-stable-speed | BENCH_PYTHON=/root/rnd/release/all/aux/py_memwatch.sh MEMWATCH_PY=/root/rnd/release/recipe/bench/py_mem.sh PYTORCH_ALLOC_CONF=backend:cudaMallocAsync PYTORCH_CUDA_ALLOC_CONF=backend:cudaMallocAsync PYTHONDONTWRITEBYTECODE=1 MEMMAX=119G EXL3_PLACEMENT='0-11=cuda:0; 12-39=cuda:1 experts=cache; ram experts=all; disk experts=off' OMP_NUM_THREADS=2 EXL3_DSV41_ENGRAM_PREFETCH=1 EXL3_STABLE_ARITHMETIC=1 EXL3_HGEMM_FIXED_ROWS=128 EXL3_MOE_FUSED_PREFILL=1 | --modes speed --prompt-tokens 32768 --gen-tokens 64 --repeats 1 --no-raw --expect-native-sha 823174af46fb
