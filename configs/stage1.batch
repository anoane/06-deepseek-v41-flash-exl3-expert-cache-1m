# ---- 1B: a static hot slice on the PRO instead of the dynamic cache (C12 layout, plain). hot=208: 28 x 208 = 5,824 resident
# experts = the C12 cache pool's 5,818 slots (same resident count; experts are 12.70 MiB each, so the fit maximum is ~230 and
# was not probed: each refused probe costs a ~3.5 min CMP load); RAM arena 28 x 176 experts = 61 GiB; PCIe via NVML (H8)
#@ est=12 timeout=1500 minavail=88
C12-S-1 | BENCH_PYTHON=/root/rnd/release/all/aux/py_memwatch.sh MEMWATCH_PY=/root/rnd/release/recipe/bench2/py_mem.sh PYTORCH_ALLOC_CONF=backend:cudaMallocAsync PYTORCH_CUDA_ALLOC_CONF=backend:cudaMallocAsync PYTHONDONTWRITEBYTECODE=1 MEMMAX=119G EXL3_PLACEMENT='0-11=cuda:0; 12-39=cuda:1 experts=stream hot=208' EXL3_MOE_PINNED_ARENA=1 | --modes h2h --scenarios short --chunk 4096 --cache-tokens 1048576 --max-output-size 32 --engram-drop --timeline 32 --expect-native-sha 823174af46fb --pcie-log 100
